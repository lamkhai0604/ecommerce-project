<mxfile host="app.diagrams.net" agent="CommerceFlow" version="24.7.17"><diagram name="Checkout-Sequence-v1.4" id="checkout-v14"><mxGraphModel dx="1500" dy="1400" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="1350"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v0" value="A. Customer -&gt; API&amp;#xa;POST /checkout; authenticated session + CSRF + Idempotency-Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="35" width="1100" height="80" as="geometry" /></mxCell><mxCell id="v1" value="B. API -&gt; Idempotency store&amp;#xa;Find (customer_id, key); compare canonical explicit request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="141" width="1100" height="80" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#3974A6;strokeWidth=2;" edge="1" parent="1" source="v0" target="v1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v2" value="C. Existing COMPLETED&amp;#xa;Same payload: replay original status/body; no cart lookup or mutation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="247" width="1100" height="80" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#3974A6;strokeWidth=2;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3" value="D. Existing mismatch / active&amp;#xa;Different payload: 409; concurrent IN_PROGRESS: retriable 409" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="353" width="1100" height="80" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#3974A6;strokeWidth=2;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v4" value="E. New key&amp;#xa;Reserve key; snapshot validated cart and shipping request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="459" width="1100" height="80" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#3974A6;strokeWidth=2;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v5" value="F. Mock payment&amp;#xa;Simulate outcome; no real card or funds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="565" width="1100" height="80" as="geometry" /></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#3974A6;strokeWidth=2;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v6" value="G. Atomic DB transaction&amp;#xa;Conditional stock decrement in deterministic product order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="671" width="1100" height="80" as="geometry" /></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#3974A6;strokeWidth=2;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v7" value="H. Atomic DB transaction&amp;#xa;Persist order + immutable snapshots; clear cart; finalize result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="777" width="1100" height="80" as="geometry" /></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#3974A6;strokeWidth=2;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v8" value="I. Response&amp;#xa;201 Created; repeat same key returns same stored 201/result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="883" width="1100" height="80" as="geometry" /></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#3974A6;strokeWidth=2;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v9" value="J. Failure / recovery&amp;#xa;Rollback mutations on failure; interrupted processing requires safe recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="989" width="1100" height="80" as="geometry" /></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#3974A6;strokeWidth=2;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v10" value="K. Separate cancellation&amp;#xa;CONFIRMED -&gt; CANCELLED guarded transition + restore stock once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#3974A6;fontColor=#163B60;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="1095" width="1100" height="80" as="geometry" /></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#3974A6;strokeWidth=2;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>